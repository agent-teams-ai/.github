{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agent-teams-ai/.github/governance/docs-protocol-policy.schema.json",
  "title": "Agent Teams documentation protocol admission policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "snapshot_revision",
    "observed_at",
    "organization",
    "inventory_snapshot_revision",
    "continuous_audit",
    "protocol",
    "admission",
    "repositories"
  ],
  "properties": {
    "$schema": { "const": "./docs-protocol-policy.schema.json" },
    "schema_version": { "const": 1 },
    "snapshot_revision": { "$ref": "#/$defs/snapshotRevision" },
    "observed_at": { "$ref": "#/$defs/date" },
    "organization": { "const": "agent-teams-ai" },
    "inventory_snapshot_revision": { "$ref": "#/$defs/snapshotRevision" },
    "continuous_audit": { "const": false },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "producer_repository",
        "producer_is_consumer",
        "version_policy",
        "fixed_gate_command",
        "reusable_workflow",
        "qualified_package_version"
      ],
      "properties": {
        "package": { "const": "@agent-teams/docs-protocol" },
        "producer_repository": { "const": "agent-teams-ai/engineering-foundation" },
        "producer_is_consumer": { "const": false },
        "version_policy": { "const": "exact_registry_version" },
        "fixed_gate_command": { "const": "pnpm docs:protocol:check" },
        "reusable_workflow": { "const": ".github/workflows/docs-protocol-check.yml" },
        "qualified_package_version": {
          "oneOf": [
            { "$ref": "#/$defs/exactVersion" },
            { "type": "null" }
          ]
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_repository_count",
        "owned_repository_count",
        "external_fork_count",
        "new_owned_repository_status",
        "qualification_evidence_required",
        "live_drift_audit"
      ],
      "properties": {
        "expected_repository_count": { "type": "integer", "minimum": 1 },
        "owned_repository_count": { "type": "integer", "minimum": 1 },
        "external_fork_count": { "type": "integer", "minimum": 0 },
        "new_owned_repository_status": { "const": "unqualified_until_admitted" },
        "qualification_evidence_required": { "const": true },
        "live_drift_audit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "required_credential", "forbidden_credentials"],
          "properties": {
            "status": { "const": "unavailable_without_dedicated_read_only_org_credential" },
            "required_credential": { "const": "dedicated_read_only_org_inventory_credential" },
            "forbidden_credentials": {
              "type": "array",
              "prefixItems": [
                { "const": "CODEX_AUTH_JSON" },
                { "const": "REVIEWROUTER_CODEX_AUTH_JSON" },
                { "const": "interactive_user_gh_token" }
              ],
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/repository" }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "snapshotRevision": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[1-9][0-9]*$"
    },
    "repositoryName": { "type": "string", "pattern": "^agent-teams-ai/[^/]+$" },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*[\\u0000-\\u001F\\u007F])(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$"
    },
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "exactVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$"
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed_revision", "evidence_paths"],
      "properties": {
        "status": { "enum": ["not_applicable", "not_qualified", "qualified"] },
        "observed_revision": { "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
        "evidence_paths": {
          "type": "array",
          "items": { "$ref": "#/$defs/path" },
          "uniqueItems": true
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "repository_id",
        "ownership",
        "role",
        "protocol_required",
        "admission_status",
        "exact_package_version",
        "profile_path",
        "caller_workflow_path",
        "reusable_workflow_revision",
        "qualification_evidence_path",
        "fixed_gate_command",
        "qualification",
        "exemption",
        "required_check_exception_id"
      ],
      "properties": {
        "repository": { "$ref": "#/$defs/repositoryName" },
        "repository_id": { "type": "integer", "minimum": 1 },
        "ownership": { "enum": ["organization_owned", "external_fork"] },
        "role": { "enum": ["governance_controller", "protocol_producer", "consumer", "exempt_external_fork"] },
        "protocol_required": { "type": "boolean" },
        "admission_status": { "enum": ["not_applicable", "pending_admission", "admitted"] },
        "exact_package_version": {
          "oneOf": [
            { "$ref": "#/$defs/exactVersion" },
            { "type": "null" }
          ]
        },
        "profile_path": { "oneOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] },
        "caller_workflow_path": { "oneOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] },
        "reusable_workflow_revision": { "oneOf": [{ "$ref": "#/$defs/sha" }, { "type": "null" }] },
        "qualification_evidence_path": { "oneOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] },
        "fixed_gate_command": { "oneOf": [{ "const": "pnpm docs:protocol:check" }, { "type": "null" }] },
        "qualification": { "$ref": "#/$defs/qualification" },
        "exemption": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "reason", "review_triggers"],
              "properties": {
                "id": { "const": "external-fork-docs-protocol" },
                "reason": { "type": "string", "minLength": 1, "pattern": "\\S" },
                "review_triggers": {
                  "type": "array",
                  "prefixItems": [
                    { "const": "fork_detached" },
                    { "const": "ownership_changed" },
                    { "const": "organization_specific_docs_added" }
                  ],
                  "minItems": 3,
                  "maxItems": 3
                }
              }
            },
            { "type": "null" }
          ]
        },
        "required_check_exception_id": {
          "oneOf": [
            { "const": "platform-private-required-checks-github-free" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
