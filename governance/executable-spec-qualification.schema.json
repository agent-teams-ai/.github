{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agent-teams-ai/.github/governance/executable-spec-qualification.schema.json",
  "title": "Agent Teams executable-specification qualification ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "ledger_revision",
    "snapshot_date",
    "authority",
    "coordinate_checksum_algorithm",
    "scope",
    "approval_policy",
    "remote_enforcement",
    "repositories"
  ],
  "properties": {
    "$schema": { "const": "./executable-spec-qualification.schema.json" },
    "schema_version": { "const": 3 },
    "ledger_revision": { "$ref": "#/$defs/nonEmpty" },
    "snapshot_date": { "$ref": "#/$defs/date" },
    "authority": { "const": "this-ledger" },
    "coordinate_checksum_algorithm": {
      "const": "sha256-internal-consistency(sorted(path + NUL + git_blob_sha + LF))"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "definition",
        "observed_repository_count",
        "active_repository_count",
        "archived_exclusions"
      ],
      "properties": {
        "definition": { "const": "active_non_archived_governance_and_product_repositories" },
        "observed_repository_count": { "type": "integer", "minimum": 1 },
        "active_repository_count": { "type": "integer", "minimum": 1 },
        "archived_exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["repository", "repository_id", "archived", "reason"],
            "properties": {
              "repository": { "type": "string", "pattern": "^agent-teams-ai/[^/]+$" },
              "repository_id": { "type": "integer", "minimum": 1 },
              "archived": { "const": true },
              "reason": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        }
      }
    },
    "approval_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "can_approve_pull_request_reviews",
        "minimum_required_approvals",
        "evidence_reference",
        "statement"
      ],
      "properties": {
        "observed_at": { "$ref": "#/$defs/date" },
        "can_approve_pull_request_reviews": { "type": "boolean" },
        "minimum_required_approvals": { "type": "integer", "minimum": 0 },
        "evidence_reference": {
          "type": "string",
          "pattern": "^https://api\\.github\\.com/"
        },
        "statement": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "remote_enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification", "observed_at", "continuous_audit", "source", "statement"],
      "properties": {
        "verification": { "enum": ["dated_api_observation", "unverified_snapshot"] },
        "observed_at": { "$ref": "#/$defs/date" },
        "continuous_audit": { "const": false },
        "source": { "$ref": "#/$defs/nonEmpty" },
        "statement": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/repository" }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.).+$" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "git_blob_sha"],
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "git_blob_sha": { "$ref": "#/$defs/revision" }
        }
      },
      "uniqueItems": true
    },
    "approvalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "revision", "entries", "coordinate_checksum_sha256"],
      "properties": {
        "status": { "enum": ["accepted_transitive", "proposed_unapproved", "not_applicable"] },
        "revision": { "oneOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }] },
        "entries": { "$ref": "#/$defs/entries" },
        "coordinate_checksum_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "specificationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_status", "revision", "entries", "coordinate_checksum_sha256", "approval_evidence"],
      "properties": {
        "evidence_status": {
          "enum": ["dated_human_reviewed_coordinates", "unverified_snapshot", "not_applicable"]
        },
        "revision": { "oneOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }] },
        "entries": { "$ref": "#/$defs/entries" },
        "coordinate_checksum_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "approval_evidence": { "$ref": "#/$defs/approvalEvidence" }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "statement",
        "evidence_status",
        "accepted_revision",
        "evidence_entries",
        "coordinate_checksum_sha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "partially_qualified_internal_slice",
            "capability_only_not_product_qualified",
            "not_qualified",
            "not_applicable"
          ]
        },
        "statement": { "$ref": "#/$defs/nonEmpty" },
        "evidence_status": {
          "enum": ["governance_accepted_coordinates", "unverified_snapshot", "not_applicable"]
        },
        "accepted_revision": {
          "oneOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }]
        },
        "evidence_entries": { "$ref": "#/$defs/entries" },
        "coordinate_checksum_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      }
    },
    "gateContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_repository_command",
        "executable_spec_commands",
        "remote_required_checks"
      ],
      "properties": {
        "full_repository_command": {
          "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
        },
        "executable_spec_commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmpty" },
          "uniqueItems": true
        },
        "remote_required_checks": { "$ref": "#/$defs/remoteRequiredChecks" }
      }
    },
    "remoteRequiredChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "exception_id",
        "default_branch",
        "ruleset_id",
        "required_approving_review_count",
        "require_code_owner_review",
        "reason",
        "checks"
      ],
      "properties": {
        "status": {
          "enum": ["observed_active", "unavailable_free_private_repository", "not_observed"]
        },
        "exception_id": {
          "oneOf": [
            { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
            { "type": "null" }
          ]
        },
        "default_branch": { "$ref": "#/$defs/nonEmpty" },
        "ruleset_id": { "type": ["integer", "null"], "minimum": 1 },
        "required_approving_review_count": { "type": ["integer", "null"], "minimum": 0 },
        "require_code_owner_review": { "type": ["boolean", "null"] },
        "reason": { "type": ["string", "null"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["context", "integration_id"],
            "properties": {
              "context": { "$ref": "#/$defs/nonEmpty" },
              "integration_id": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "repository_id",
        "archived",
        "owner_reference",
        "applicability",
        "specification_maturity",
        "specification_scope",
        "specification_evidence",
        "implementation_qualification",
        "deployment_qualification",
        "gate_contract"
      ],
      "properties": {
        "repository": { "type": "string", "pattern": "^agent-teams-ai/[^/]+$" },
        "repository_id": { "type": "integer", "minimum": 1 },
        "archived": { "const": false },
        "owner_reference": {
          "type": "string",
          "pattern": "^https://github\\.com/[A-Za-z0-9-]+$"
        },
        "applicability": {
          "enum": ["capability_owner", "applicable", "governance_only", "not_applicable"]
        },
        "specification_maturity": {
          "enum": [
            "capability_implemented",
            "synthetic_proposed",
            "implemented_internal_slice",
            "accepted_partial_projections",
            "governance_only",
            "not_applicable"
          ]
        },
        "specification_scope": { "$ref": "#/$defs/nonEmpty" },
        "specification_evidence": { "$ref": "#/$defs/specificationEvidence" },
        "implementation_qualification": { "$ref": "#/$defs/qualification" },
        "deployment_qualification": { "$ref": "#/$defs/qualification" },
        "gate_contract": { "$ref": "#/$defs/gateContract" }
      }
    }
  }
}
