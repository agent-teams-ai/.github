{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agent-teams-ai/.github/governance/executable-spec-qualification.schema.json",
  "title": "Agent Teams executable-specification qualification ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "ledger_revision",
    "snapshot_date",
    "authority",
    "approval_policy",
    "remote_enforcement",
    "repositories"
  ],
  "properties": {
    "$schema": { "const": "./executable-spec-qualification.schema.json" },
    "schema_version": { "const": 2 },
    "ledger_revision": { "$ref": "#/$defs/nonEmpty" },
    "snapshot_date": { "$ref": "#/$defs/date" },
    "authority": { "const": "this-ledger" },
    "approval_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "can_approve_pull_request_reviews",
        "minimum_required_approvals",
        "evidence_reference",
        "statement"
      ],
      "properties": {
        "observed_at": { "$ref": "#/$defs/date" },
        "can_approve_pull_request_reviews": { "type": "boolean" },
        "minimum_required_approvals": { "type": "integer", "minimum": 0 },
        "evidence_reference": { "$ref": "#/$defs/nonEmpty" },
        "statement": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "remote_enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification", "observed_at", "continuous_audit", "source", "statement"],
      "properties": {
        "verification": { "enum": ["dated_api_observation", "unverified_snapshot"] },
        "observed_at": { "$ref": "#/$defs/date" },
        "continuous_audit": { "const": false },
        "source": { "$ref": "#/$defs/nonEmpty" },
        "statement": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/repository" }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.).+$" },
    "paths": {
      "type": "array",
      "items": { "$ref": "#/$defs/path" },
      "uniqueItems": true
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "authority"],
      "properties": {
        "repository": { "type": "string", "pattern": "^agent-teams-ai/[^/]+$" },
        "authority": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "specificationEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification", "revision", "paths"],
      "properties": {
        "verification": {
          "enum": ["verified_at_revision", "unverified_snapshot", "not_applicable"]
        },
        "revision": { "oneOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }] },
        "paths": { "$ref": "#/$defs/paths" }
      }
    },
    "qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "statement",
        "verification",
        "qualified_revision",
        "evidence_paths"
      ],
      "properties": {
        "status": {
          "enum": [
            "partially_qualified_internal_slice",
            "capability_only_not_product_qualified",
            "not_qualified",
            "not_applicable"
          ]
        },
        "statement": { "$ref": "#/$defs/nonEmpty" },
        "verification": {
          "enum": ["qualified_at_revision", "unverified_snapshot", "not_applicable"]
        },
        "qualified_revision": {
          "oneOf": [{ "$ref": "#/$defs/revision" }, { "type": "null" }]
        },
        "evidence_paths": { "$ref": "#/$defs/paths" }
      }
    },
    "gateContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_repository_command",
        "executable_spec_commands",
        "remote_required_checks"
      ],
      "properties": {
        "full_repository_command": {
          "oneOf": [{ "$ref": "#/$defs/nonEmpty" }, { "type": "null" }]
        },
        "executable_spec_commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/nonEmpty" },
          "uniqueItems": true
        },
        "remote_required_checks": { "$ref": "#/$defs/remoteRequiredChecks" }
      }
    },
    "remoteRequiredChecks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "default_branch", "ruleset_id", "reason", "checks"],
      "properties": {
        "status": {
          "enum": ["observed_active", "unavailable_free_private_repository", "not_observed"]
        },
        "default_branch": { "$ref": "#/$defs/nonEmpty" },
        "ruleset_id": { "type": ["integer", "null"], "minimum": 1 },
        "reason": { "type": ["string", "null"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["context", "integration_id"],
            "properties": {
              "context": { "$ref": "#/$defs/nonEmpty" },
              "integration_id": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "owner",
        "applicability",
        "specification_maturity",
        "specification_scope",
        "specification_evidence",
        "implementation_qualification",
        "deployment_qualification",
        "gate_contract"
      ],
      "properties": {
        "repository": { "type": "string", "pattern": "^agent-teams-ai/[^/]+$" },
        "owner": { "$ref": "#/$defs/owner" },
        "applicability": {
          "enum": ["capability_owner", "applicable", "governance_only", "not_applicable"]
        },
        "specification_maturity": {
          "enum": [
            "capability_implemented",
            "synthetic_proposed",
            "implemented_internal_slice",
            "accepted_partial_projections",
            "governance_only",
            "not_applicable"
          ]
        },
        "specification_scope": { "$ref": "#/$defs/nonEmpty" },
        "specification_evidence": { "$ref": "#/$defs/specificationEvidence" },
        "implementation_qualification": { "$ref": "#/$defs/qualification" },
        "deployment_qualification": { "$ref": "#/$defs/qualification" },
        "gate_contract": { "$ref": "#/$defs/gateContract" }
      }
    }
  }
}
