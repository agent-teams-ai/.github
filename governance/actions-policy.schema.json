{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agent-teams-ai/.github/governance/actions-policy.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "snapshot_revision",
    "observed_at",
    "continuous_audit",
    "owner_reference",
    "organization_workflow_permissions",
    "owner_bootstrap_release_pr",
    "action_sha_pinning",
    "required_check_exception_ids"
  ],
  "properties": {
    "$schema": { "const": "./actions-policy.schema.json" },
    "schema_version": { "const": 4 },
    "snapshot_revision": { "$ref": "#/$defs/nonEmpty" },
    "observed_at": { "$ref": "#/$defs/date" },
    "continuous_audit": { "const": false },
    "owner_reference": { "$ref": "#/$defs/githubReference" },
    "organization_workflow_permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification",
        "default_workflow_permissions",
        "can_approve_pull_request_reviews",
        "evidence_endpoint"
      ],
      "properties": {
        "verification": { "const": "observed_api_snapshot" },
        "default_workflow_permissions": { "const": "read" },
        "can_approve_pull_request_reviews": { "const": false },
        "evidence_endpoint": {
          "const": "https://api.github.com/orgs/agent-teams-ai/actions/permissions/workflow"
        }
      }
    },
    "owner_bootstrap_release_pr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "pull_request_creation",
        "workflow_run_approval",
        "rerun_policy",
        "organization_create_and_approve_enabled",
        "merge_requirements"
      ],
      "properties": {
        "mode": { "const": "workflow_generated_owner_bootstrap" },
        "pull_request_creation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actor", "head_commit_author", "required_verification"],
          "properties": {
            "actor": { "const": "repository_owner" },
            "head_commit_author": { "const": "github-actions[bot]" },
            "required_verification": { "$ref": "#/$defs/releaseRevisionVerification" }
          }
        },
        "workflow_run_approval": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "actor", "allowed_run_author", "required_verification"],
          "properties": {
            "mode": { "const": "manual_after_inspection" },
            "actor": { "const": "repository_owner" },
            "allowed_run_author": { "const": "github-actions[bot]" },
            "required_verification": { "$ref": "#/$defs/releaseRevisionVerification" }
          }
        },
        "rerun_policy": { "const": "failed_release_only" },
        "organization_create_and_approve_enabled": { "const": false },
        "merge_requirements": {
          "type": "array",
          "prefixItems": [
            { "const": "required_checks" },
            { "const": "reviewrouter" },
            { "const": "release_attestation" }
          ],
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "action_sha_pinning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verification",
        "evidence_endpoint",
        "enabled_repositories",
        "allowed_actions",
        "sha_pinning_required",
        "rollout_status",
        "fully_enforced",
        "pending"
      ],
      "properties": {
        "verification": { "const": "observed_api_snapshot" },
        "evidence_endpoint": {
          "const": "https://api.github.com/orgs/agent-teams-ai/actions/permissions"
        },
        "enabled_repositories": { "const": "all" },
        "allowed_actions": { "const": "all" },
        "sha_pinning_required": { "type": "boolean" },
        "rollout_status": { "enum": ["pending_gateway_pr", "enforced"] },
        "fully_enforced": { "type": "boolean" },
        "pending": {
          "type": "array",
          "items": { "$ref": "#/$defs/exception" }
        }
      }
    },
    "required_check_exception_ids": {
      "type": "array",
      "items": { "$ref": "#/$defs/exceptionId" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "exceptionId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "githubReference": { "type": "string", "pattern": "^https://github\\.com/[^/]+(?:/[^/]+(?:/.*)?)?$" },
    "releaseRevisionVerification": {
      "type": "array",
      "prefixItems": [
        { "const": "exact_generated_diff" },
        { "const": "exact_head_sha" },
        { "const": "exact_base_sha" }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "reason", "reference"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "reason": { "$ref": "#/$defs/nonEmpty" },
        "reference": { "$ref": "#/$defs/githubReference" }
      }
    }
  }
}
