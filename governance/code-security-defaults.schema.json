{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agent-teams-ai/.github/governance/code-security-defaults.schema.json",
  "title": "Agent Teams code-security defaults snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "snapshot_revision",
    "observed_at",
    "organization",
    "owner",
    "evidence",
    "defaults",
    "repository_attachments",
    "dependabot_policy",
    "transfer_policy",
    "required_check_exceptions"
  ],
  "properties": {
    "$schema": { "const": "./code-security-defaults.schema.json" },
    "schema_version": { "const": 2 },
    "snapshot_revision": { "$ref": "#/$defs/nonEmpty" },
    "observed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "organization": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "owner": { "type": "string", "pattern": "^https://github\\.com/[^/]+$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification", "endpoint"],
      "properties": {
        "verification": { "enum": ["observed_api_snapshot", "unverified_snapshot"] },
        "endpoint": { "type": ["string", "null"] }
      }
    },
    "defaults": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/default" }
    },
    "repository_attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "repository_id",
          "configuration_id",
          "status",
          "dependabot_alerts_enablement_http_status",
          "dependabot_security_updates",
          "ghas_billing_repositories",
          "observed_at",
          "evidence_endpoint"
        ],
        "properties": {
          "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
          "repository_id": { "type": "integer", "minimum": 1 },
          "configuration_id": { "type": "integer", "minimum": 1 },
          "status": { "const": "enforced" },
          "dependabot_alerts_enablement_http_status": { "const": 204 },
          "dependabot_security_updates": { "const": "enabled_unpaused" },
          "ghas_billing_repositories": { "type": "integer", "minimum": 0 },
          "observed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "evidence_endpoint": { "type": "string", "pattern": "^https://api\\.github\\.com/" }
        }
      }
    },
    "dependabot_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "routine_version_update_owner"],
      "properties": {
        "scope": { "const": "security_updates_only" },
        "routine_version_update_owner": { "const": "renovate" }
      }
    },
    "transfer_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic_default_application_assumed", "required_action"],
      "properties": {
        "automatic_default_application_assumed": { "const": false },
        "required_action": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "required_check_exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/requiredCheckException" }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "toggle": { "enum": ["enabled", "disabled"] },
    "default": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "default_for_new_repositories",
        "enforcement",
        "dependency_graph",
        "dependabot_alerts",
        "dependabot_security_updates",
        "advanced_security",
        "code_scanning_default_setup",
        "secret_scanning",
        "secret_scanning_push_protection"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "default_for_new_repositories": {
          "enum": ["public", "private_and_internal"]
        },
        "enforcement": { "const": "enforced" },
        "dependency_graph": { "const": "enabled" },
        "dependabot_alerts": { "const": "enabled" },
        "dependabot_security_updates": { "const": "enabled" },
        "advanced_security": { "$ref": "#/$defs/toggle" },
        "code_scanning_default_setup": { "$ref": "#/$defs/toggle" },
        "secret_scanning": { "$ref": "#/$defs/toggle" },
        "secret_scanning_push_protection": { "$ref": "#/$defs/toggle" }
      }
    },
    "requiredCheckException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "reason", "compensation"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "reason": { "$ref": "#/$defs/nonEmpty" },
        "compensation": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  }
}
