{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agent-teams-ai/.github/governance/code-security-defaults.schema.json",
  "title": "Agent Teams code-security defaults snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "snapshot_revision",
    "observed_at",
    "continuous_audit",
    "organization",
    "owner",
    "defaults_evidence",
    "defaults",
    "organization_observations",
    "repository_attachments",
    "dependabot_policy",
    "transfer_policy",
    "required_check_exceptions"
  ],
  "properties": {
    "$schema": { "const": "./code-security-defaults.schema.json" },
    "schema_version": { "const": 4 },
    "snapshot_revision": { "$ref": "#/$defs/nonEmpty" },
    "observed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "continuous_audit": { "const": false },
    "organization": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
    "owner": { "type": "string", "pattern": "^https://github\\.com/[^/]+$" },
    "defaults_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification", "endpoint"],
      "properties": {
        "verification": { "enum": ["observed_api_snapshot", "unverified_snapshot"] },
        "endpoint": { "type": ["string", "null"] }
      }
    },
    "defaults": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/default" }
    },
    "organization_observations": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/organizationObservation" }
    },
    "repository_attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repository",
          "repository_id",
          "observed_at",
          "evidence_records"
        ],
        "properties": {
          "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
          "repository_id": { "type": "integer", "minimum": 1 },
          "observed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "evidence_records": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "$ref": "#/$defs/attachmentEvidence" }
          }
        }
      }
    },
    "dependabot_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "routine_version_update_owner"],
      "properties": {
        "scope": { "const": "security_updates_only" },
        "routine_version_update_owner": { "const": "renovate" }
      }
    },
    "transfer_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["automatic_default_application_assumed", "required_action"],
      "properties": {
        "automatic_default_application_assumed": { "const": false },
        "required_action": { "$ref": "#/$defs/nonEmpty" }
      }
    },
    "required_check_exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/requiredCheckException" }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "toggle": { "enum": ["enabled", "disabled"] },
    "apiEndpoint": { "type": "string", "pattern": "^https://api\\.github\\.com/" },
    "organizationObservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim", "observed_at", "method", "endpoint", "total_count"],
          "properties": {
            "claim": { "const": "organization_ghas_billing" },
            "observed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "method": { "const": "GET" },
            "endpoint": { "$ref": "#/$defs/apiEndpoint" },
            "total_count": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim", "observed_at", "method", "endpoint", "value", "transition_status", "risk", "compensation"],
          "properties": {
            "claim": { "const": "two_factor_requirement_enabled" },
            "observed_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "method": { "const": "GET" },
            "endpoint": { "$ref": "#/$defs/apiEndpoint" },
            "value": { "type": "boolean" },
            "transition_status": { "enum": ["none", "pending_user_confirmation", "deferred_by_owner"] },
            "risk": { "type": ["string", "null"], "minLength": 1 },
            "compensation": { "type": ["string", "null"], "minLength": 1 }
          }
        }
      ]
    },
    "attachmentEvidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim", "method", "endpoint", "configuration_id", "status"],
          "properties": {
            "claim": { "const": "configuration_attachment" },
            "method": { "const": "GET" },
            "endpoint": { "$ref": "#/$defs/apiEndpoint" },
            "configuration_id": { "type": "integer", "minimum": 1 },
            "status": { "const": "enforced" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim", "method", "endpoint", "http_status"],
          "properties": {
            "claim": { "const": "dependabot_alerts_enablement" },
            "method": { "const": "PUT" },
            "endpoint": { "$ref": "#/$defs/apiEndpoint" },
            "http_status": { "const": 204 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["claim", "method", "endpoint", "http_status", "enabled", "paused"],
          "properties": {
            "claim": { "const": "automated_security_fixes" },
            "method": { "const": "GET" },
            "endpoint": { "$ref": "#/$defs/apiEndpoint" },
            "http_status": { "const": 200 },
            "enabled": { "const": true },
            "paused": { "const": false }
          }
        }
      ]
    },
    "default": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "default_for_new_repositories",
        "enforcement",
        "dependency_graph",
        "dependabot_alerts",
        "dependabot_security_updates",
        "advanced_security",
        "code_scanning_default_setup",
        "secret_scanning",
        "secret_scanning_push_protection"
      ],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "$ref": "#/$defs/nonEmpty" },
        "default_for_new_repositories": {
          "enum": ["public", "private_and_internal"]
        },
        "enforcement": { "const": "enforced" },
        "dependency_graph": { "const": "enabled" },
        "dependabot_alerts": { "const": "enabled" },
        "dependabot_security_updates": { "const": "enabled" },
        "advanced_security": { "$ref": "#/$defs/toggle" },
        "code_scanning_default_setup": { "$ref": "#/$defs/toggle" },
        "secret_scanning": { "$ref": "#/$defs/toggle" },
        "secret_scanning_push_protection": { "$ref": "#/$defs/toggle" }
      }
    },
    "requiredCheckException": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "repository", "reason", "compensation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
        "reason": { "$ref": "#/$defs/nonEmpty" },
        "compensation": { "$ref": "#/$defs/nonEmpty" }
      }
    }
  }
}
