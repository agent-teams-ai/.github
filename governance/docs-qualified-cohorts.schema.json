{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agent-teams-ai/.github/governance/docs-qualified-cohorts.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "organization", "policy", "cohorts", "events"],
  "properties": {
    "$schema": { "const": "./docs-qualified-cohorts.schema.json" },
    "schema_version": { "const": 1 },
    "organization": { "const": "agent-teams-ai" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_release_age_hours", "inventory_page_size", "inventory_max_pages", "inventory_termination", "authority"],
      "properties": {
        "minimum_release_age_hours": { "type": "integer", "minimum": 1, "maximum": 168 },
        "inventory_page_size": { "const": 100 },
        "inventory_max_pages": { "type": "integer", "minimum": 2, "maximum": 1000 },
        "inventory_termination": { "const": "first_empty_page" },
        "authority": { "const": "recommended_cohort_only" }
      }
    },
    "cohorts": {
      "type": "array",
      "items": { "$ref": "#/$defs/cohort" }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^(?!0{40}$)[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^sha256:(?!0{64}$)[0-9a-f]{64}$" },
    "sri": { "type": "string", "pattern": "^sha512-[A-Za-z0-9+/]{86}==$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z]+(?:[.-][0-9A-Za-z]+)*)?$" },
    "cohortId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{3})?Z$" },
    "timestampSeconds": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^/]+(?:/[^/]+)*$" },
    "repository": { "type": "string", "pattern": "^agent-teams-ai/[A-Za-z0-9_.-]+$" },
    "reference": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "integrity", "registry", "published_at", "provenance"],
      "properties": {
        "name": { "enum": ["@agent-teams/docs-protocol", "@agent-teams/engineering-foundation"] },
        "version": { "$ref": "#/$defs/version" },
        "integrity": { "$ref": "#/$defs/sri" },
        "registry": { "const": "https://registry.npmjs.org/" },
        "published_at": { "$ref": "#/$defs/timestamp" },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_repository", "source_repository_id", "source_workflow", "source_commit", "workflow_run_id", "workflow_run_attempt", "registry_attestation_url", "workflow_run_url", "signature_verified"],
          "properties": {
            "source_repository": { "const": "agent-teams-ai/engineering-foundation" },
            "source_repository_id": { "const": 1316243988 },
            "source_workflow": { "$ref": "#/$defs/path" },
            "source_commit": { "$ref": "#/$defs/sha" },
            "workflow_run_id": { "type": "integer", "minimum": 1 },
            "workflow_run_attempt": { "type": "integer", "minimum": 1 },
            "registry_attestation_url": { "type": "string", "pattern": "^https://registry\\.npmjs\\.org/-/npm/v1/attestations/@agent-teams%2f(?:engineering-foundation|docs-protocol)@[0-9A-Za-z.-]+$" },
            "workflow_run_url": { "type": "string", "pattern": "^https://github\\.com/agent-teams-ai/engineering-foundation/actions/runs/[1-9][0-9]+$" },
            "signature_verified": { "const": true },
            "reconciliation": {
              "type": "object",
              "additionalProperties": false,
              "required": ["workflow_run_attempt", "release_job_id"],
              "properties": {
                "workflow_run_attempt": { "type": "integer", "minimum": 1 },
                "release_job_id": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cohort_id", "channel", "packages", "reusable_workflow", "schemas", "assets", "runtime", "runtime_closure", "eligible_after", "upgrade_from", "rollback_to", "canary_repositories", "evidence_references", "record_digest"],
      "properties": {
        "cohort_id": { "$ref": "#/$defs/cohortId" },
        "channel": { "enum": ["rc", "stable"] },
        "packages": {
          "type": "array",
          "prefixItems": [
            { "$ref": "#/$defs/package" },
            { "$ref": "#/$defs/package" }
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "reusable_workflow": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "repository_id", "path", "revision", "blob_sha"],
          "properties": {
            "repository": { "const": "agent-teams-ai/.github" },
            "repository_id": { "const": 1316243981 },
            "path": { "const": ".github/workflows/docs-protocol-check.yml" },
            "revision": { "$ref": "#/$defs/sha" },
            "blob_sha": { "$ref": "#/$defs/sha" }
          }
        },
        "schemas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["consumer_integration", "consumer_plan", "managed_state", "foundation_plan", "foundation_journal", "foundation_receipt", "foundation_envelope", "docs_protocol"],
          "properties": {
            "consumer_integration": { "const": 1 },
            "consumer_plan": { "const": 1 },
            "managed_state": { "const": 1 },
            "foundation_plan": { "const": 1 },
            "foundation_journal": { "const": 1 },
            "foundation_receipt": { "const": 1 },
            "foundation_envelope": { "const": 5 },
            "docs_protocol": { "const": 1 }
          }
        },
        "assets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["skill", "caller_workflow", "asset_catalog", "transition_catalog"],
          "properties": {
            "skill": { "$ref": "#/$defs/publishedAsset" },
            "caller_workflow": { "$ref": "#/$defs/publishedCallerWorkflow" },
            "asset_catalog": { "$ref": "#/$defs/publishedAsset" },
            "transition_catalog": { "$ref": "#/$defs/publishedAsset" }
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node", "pnpm", "apply_platforms", "check_plan_platforms"],
          "properties": {
            "node": { "const": ">=24.18.0 <25" },
            "pnpm": { "const": ">=11.17.0 <12" },
            "apply_platforms": { "const": ["linux", "macos"] },
            "check_plan_platforms": { "const": ["linux", "macos", "windows"] }
          }
        },
        "runtime_closure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "package_manager", "lockfile_version", "package_count", "projection_path", "digest"],
          "properties": {
            "schema_version": { "const": 1 },
            "package_manager": { "const": "pnpm@11.18.0" },
            "lockfile_version": { "const": "9.0" },
            "package_count": { "type": "integer", "minimum": 2, "maximum": 2048 },
            "projection_path": { "type": "string", "pattern": "^governance/docs-runtime-closures/sha256-[0-9a-f]{64}\\.json$" },
            "digest": { "$ref": "#/$defs/sha256" }
          }
        },
        "eligible_after": { "$ref": "#/$defs/timestampSeconds" },
        "upgrade_from": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/cohortId" }, "uniqueItems": true },
        "rollback_to": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/cohortId" }, "uniqueItems": true },
        "canary_repositories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/canaryRepository" },
          "uniqueItems": true
        },
        "evidence_references": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/reference" }, "uniqueItems": true },
        "record_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "publishedAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "path", "digest"],
      "properties": {
        "package": { "const": "@agent-teams/docs-protocol" },
        "path": { "$ref": "#/$defs/path" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "publishedCallerWorkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package", "path", "digest", "rendered_digest"],
      "properties": {
        "package": { "const": "@agent-teams/docs-protocol" },
        "path": { "$ref": "#/$defs/path" },
        "digest": { "$ref": "#/$defs/sha256" },
        "rendered_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "cohort_id", "state", "effective_at", "support_until", "evidence_references", "canary_evidence", "previous_event_digest", "event_digest"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "cohort_id": { "$ref": "#/$defs/cohortId" },
        "state": { "enum": ["PUBLISHED_UNQUALIFIED", "VERIFIED", "COOLDOWN", "QUALIFIED", "CANARY", "RECOMMENDED", "SUPERSEDED", "SUPPORT_ENDED", "SUSPENDED", "WITHDRAWN"] },
        "effective_at": { "$ref": "#/$defs/timestamp" },
        "support_until": { "oneOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] },
        "evidence_references": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/reference" }, "uniqueItems": true },
        "canary_evidence": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/canaryEvidence" }
        },
        "previous_event_digest": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "event_digest": { "$ref": "#/$defs/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "state": { "const": "CANARY" } }, "required": ["state"] },
          "then": { "properties": { "canary_evidence": { "type": "array", "minItems": 1 } } },
          "else": { "properties": { "canary_evidence": { "type": "array", "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "state": { "const": "SUPERSEDED" } }, "required": ["state"] },
          "then": { "properties": { "support_until": { "$ref": "#/$defs/timestamp" } } },
          "else": { "properties": { "support_until": { "type": "null" } } }
        }
      ]
    },
    "canaryRepository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "repository"],
      "properties": {
        "repository_id": { "type": "integer", "minimum": 1 },
        "repository": { "$ref": "#/$defs/repository" }
      }
    },
    "canaryEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "repository", "merge_revision", "observed_cohort_id", "observed_record_digest", "observed_event_digest", "required_context", "integration_id", "conclusion", "check_run_id", "check_run_url", "workflow_run_id", "workflow_id", "caller_workflow_path", "caller_workflow_digest"],
      "properties": {
        "repository_id": { "type": "integer", "minimum": 1 },
        "repository": { "$ref": "#/$defs/repository" },
        "merge_revision": { "$ref": "#/$defs/sha" },
        "observed_cohort_id": { "$ref": "#/$defs/cohortId" },
        "observed_record_digest": { "$ref": "#/$defs/sha256" },
        "observed_event_digest": { "$ref": "#/$defs/sha256" },
        "required_context": { "type": "string", "minLength": 1, "maxLength": 256 },
        "integration_id": { "type": "integer", "minimum": 1 },
        "conclusion": { "const": "success" },
        "check_run_id": { "type": "integer", "minimum": 1 },
        "check_run_url": { "type": "string", "pattern": "^https://github\\.com/agent-teams-ai/[A-Za-z0-9_.-]+/actions/runs/[1-9][0-9]+(?:/job/[1-9][0-9]+)?$" },
        "workflow_run_id": { "type": "integer", "minimum": 1 },
        "workflow_id": { "type": "integer", "minimum": 1 },
        "caller_workflow_path": { "type": "string", "pattern": "^\\.github/workflows/[^/]+\\.ya?ml$" },
        "caller_workflow_digest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
